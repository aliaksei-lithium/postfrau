{
  "info": {
    "_postman_id": "b2f1c0de-1111-4a2b-9c3d-000000000001",
    "name": "Acme API",
    "description": "The example collection our importer is measured against.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345678"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": ["console.log('hi')"] }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.acme.dev", "type": "default" },
    { "key": "apiToken", "value": "", "type": "secret" }
  ],
  "item": [
    {
      "name": "Users",
      "description": "Everything about users.",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users?page=2&per_page=50",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "per_page", "value": "50", "description": "Max 100." },
                { "key": "include", "value": "roles", "disabled": true }
              ]
            },
            "description": "Paginated."
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\"data\":[]}" }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"]
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "ada", "type": "string" },
                { "key": "password", "value": "lovelace", "type": "string" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload avatar",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "caption", "value": "My face", "type": "text" },
                { "key": "file", "type": "file", "src": "/Users/someone/Pictures/me.png" },
                { "key": "skipped", "value": "x", "type": "text", "disabled": true }
              ]
            },
            "url": { "raw": "{{baseUrl}}/v1/avatar", "host": ["{{baseUrl}}"], "path": ["v1", "avatar"] }
          }
        },
        {
          "name": "Legacy form post",
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "scope", "value": "read write" }
              ]
            },
            "url": { "raw": "https://auth.acme.dev/token", "protocol": "https", "host": ["auth", "acme", "dev"], "path": ["token"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "https://api.acme.dev/health",
        "auth": {
          "type": "oauth2",
          "oauth2": [{ "key": "accessToken", "value": "x", "type": "string" }]
        }
      }
    },
    {
      "name": "Raw binary",
      "request": {
        "method": "PUT",
        "body": { "mode": "file", "file": { "src": "/tmp/payload.bin" } },
        "url": { "raw": "{{baseUrl}}/v1/blob", "host": ["{{baseUrl}}"], "path": ["v1", "blob"] }
      }
    }
  ],
  "protocolProfileBehavior": { "disableBodyPruning": true }
}
